<wpml-config>
	<custom-types>
		<custom-type translate="1">html_block</custom-type>
	</custom-types>
	<admin-texts>
        <key name="theme_mods_luchiana-child">
			<key name="header_phone" />
			<key name="header_email" />
			<key name="header_address" />
			<key name="header_hours" />
			<key name="header_other" />
			<key name="product_header" />
			<key name="footer_copyright" />
			<key name="store_notice_button_text" />
			<key name="product_grid_load_more_text" />
			<key name="description_tab_header" />
			<key name="additional_information_tab_header" />
			<key name="outofstock_badge_text" />
			<key name="featured_badge_text" />
			<key name="sale_badge_text" />
			<key name="new_badge_text" />
			<key name="related_product_header" />
			<key name="upsells_product_header" />
			<key name="cross_sells_product_header" />
			<key name="recently_product_header" />
			<key name="ajax_search_title" />
		</key>
	</admin-texts>
	<elementor-widgets>
		<widget name="ideapark-heading">
			<fields>
				<field type="Heading: Title" editor_type="LINE">title</field>
				<field type="Heading: Link" editor_type="LINK">link>url</field>
			</fields>
		</widget>
		<widget name="ideapark-page-header">
			<fields>
				<field type="Page Header: Custom Title" editor_type="LINE">custom_title</field>
			</fields>
		</widget>
		<widget name="ideapark-button">
			<fields>
				<field type="Button: Text" editor_type="LINE">text</field>
				<field type="Button: Link" editor_type="LINK">link>url</field>
			</fields>
		</widget>
		<widget name="ideapark-social">
			<fields>
				<field type="Social: Facebook Url" editor_type="LINK">soc-facebook>url</field>
				<field type="Social: Instagram Url" editor_type="LINK">soc-instagram>url</field>
				<field type="Social: VK Url" editor_type="LINK">soc-vk>url</field>
				<field type="Social: OK Url" editor_type="LINK">soc-ok>url</field>
				<field type="Social: Telegram Url" editor_type="LINK">soc-telegram>url</field>
				<field type="Social: Whatsapp Url" editor_type="LINK">soc-whatsapp>url</field>
				<field type="Social: Line Url" editor_type="LINK">soc-line>url</field>
				<field type="Social: Wechat Url" editor_type="LINK">soc-wechat>url</field>
				<field type="Social: Viber Url" editor_type="LINK">soc-viber>url</field>
				<field type="Social: Discord Url" editor_type="LINK">soc-discord>url</field>
				<field type="Social: Twitter Url" editor_type="LINK">soc-twitter>url</field>
				<field type="Social: Youtube Url" editor_type="LINK">soc-youtube>url</field>
				<field type="Social: Vimeo Url" editor_type="LINK">soc-vimeo>url</field>
				<field type="Social: Snapchat Url" editor_type="LINK">soc-snapchat>url</field>
				<field type="Social: Tiktok Url" editor_type="LINK">soc-tiktok>url</field>
				<field type="Social: Linkedin Url" editor_type="LINK">soc-linkedin>url</field>
				<field type="Social: Flickr Url" editor_type="LINK">soc-flickr>url</field>
				<field type="Social: Pinterest Url" editor_type="LINK">soc-pinterest>url</field>
				<field type="Social: Tumblr Url" editor_type="LINK">soc-tumblr>url</field>
				<field type="Social: Github Url" editor_type="LINK">soc-github>url</field>
				<field type="Social: Custom Url 1" editor_type="LINK">custom-soc-url-1>url</field>
				<field type="Social: Custom Url 2" editor_type="LINK">custom-soc-url-2>url</field>
			</fields>
		</widget>
		<widget name="ideapark-mega-menu">
			<fields>
				<field type="Mega Menu Block: Title" editor_type="LINE">title</field>
				<field type="Mega Menu Block: Link" editor_type="LINK">link>url</field>
			</fields>
		</widget>
		<widget name="ideapark-product-tabs">
			<fields>
				<field>tabs</field>
			</fields>
			<fields-in-item items_of="tabs">
				<field type="Product Tabs: Title" editor_type="LINE">title</field>
				<field type="Product Tabs: Shortcode" editor_type="AREA">shortcode</field>
				<field type="Product Tabs: Button Text" editor_type="LINE">button_text</field>
				<field type="Product Tabs: Button Link" editor_type="LINK">button_link>url</field>
			</fields-in-item>
		</widget>
		<widget name="ideapark-woocommerce-carousel">
			<fields>
				<field type="Product Carousel: Shortcode" editor_type="AREA">shortcode</field>
			</fields>
		</widget>
		<widget name="ideapark-woocommerce-grid">
			<fields>
				<field type="Product Grid: Shortcode" editor_type="AREA">shortcode</field>
			</fields>
		</widget>
		<widget name="ideapark-slider">
			<fields>
				<field>slider_list</field>
			</fields>
			<fields-in-item items_of="slider_list">
				<field type="Slider: Above Title" editor_type="AREA">text_above</field>
				<field type="Slider: Title" editor_type="LINE">title</field>
				<field type="Slider: Description" editor_type="AREA">description</field>
				<field type="Slider: Button Text" editor_type="LINE">button_text</field>
				<field type="Slider: Button Url" editor_type="LINK">button_link>url</field>
			</fields-in-item>
		</widget>
		<widget name="ideapark-reviews">
			<fields>
				<field>review_list</field>
			</fields>
			<fields-in-item items_of="review_list">
				<field type="Reviews: Reviewer Name" editor_type="LINE">reviewer_name</field>
				<field type="Reviews: Review Body" editor_type="AREA">reviewer_text</field>
			</fields-in-item>
		</widget>
		<widget name="ideapark-icon-list-1">
			<fields>
				<field>icon_list</field>
				<field type="Icon List: Button Text" editor_type="LINE">button_text</field>
			</fields>
			<fields-in-item items_of="icon_list">
				<field type="Icon List: Title" editor_type="LINE">title</field>
				<field type="Icon List: Description" editor_type="AREA">description</field>
				<field type="Icon List: Link" editor_type="LINK">link>url</field>
			</fields-in-item>
		</widget>
		<widget name="ideapark-image-list-1">
			<fields>
				<field>icon_list</field>
			</fields>
			<fields-in-item items_of="icon_list">
				<field type="Image List: Title" editor_type="LINE">title_text</field>
				<field type="Image List: Link" editor_type="LINK">link>url</field>
			</fields-in-item>
		</widget>
		<widget name="ideapark-instagram">
			<fields>
				<field type="Instagram: Account Title" editor_type="LINE">title</field>
				<field type="Instagram: Account Link" editor_type="LINK">link>url</field>
			</fields>
		</widget>
		<widget name="ideapark-team">
			<fields>
				<field>icon_list</field>
			</fields>
			<fields-in-item items_of="icon_list">
				<field type="Team Members: Name" editor_type="LINE">name</field>
				<field type="Team Members: Occupation" editor_type="LINE">occupation</field>
				<field type="Team Members: Description" editor_type="AREA">description</field>
				<field type="Team Members: Phone" editor_type="LINE">phone</field>
				<field type="Team Members: Email" editor_type="LINE">email</field>
				<field type="Team Members: Link" editor_type="LINK">link>url</field>
				<field type="Team Members: Facebook Url" editor_type="LINK">soc-facebook>url</field>
				<field type="Team Members: Instagram Url" editor_type="LINK">soc-instagram>url</field>
				<field type="Team Members: VK Url" editor_type="LINK">soc-vk>url</field>
				<field type="Team Members: OK Url" editor_type="LINK">soc-ok>url</field>
				<field type="Team Members: Telegram Url" editor_type="LINK">soc-telegram>url</field>
				<field type="Team Members: Whatsapp Url" editor_type="LINK">soc-whatsapp>url</field>
				<field type="Team Members: Line Url" editor_type="LINK">soc-line>url</field>
				<field type="Team Members: Wechat Url" editor_type="LINK">soc-wechat>url</field>
				<field type="Team Members: Viber Url" editor_type="LINK">soc-viber>url</field>
				<field type="Team Members: Discord Url" editor_type="LINK">soc-discord>url</field>
				<field type="Team Members: Twitter Url" editor_type="LINK">soc-twitter>url</field>
				<field type="Team Members: Youtube Url" editor_type="LINK">soc-youtube>url</field>
				<field type="Team Members: Vimeo Url" editor_type="LINK">soc-vimeo>url</field>
				<field type="Team Members: Snapchat Url" editor_type="LINK">soc-snapchat>url</field>
				<field type="Team Members: Tiktok Url" editor_type="LINK">soc-tiktok>url</field>
				<field type="Team Members: Linkedin Url" editor_type="LINK">soc-linkedin>url</field>
				<field type="Team Members: Flickr Url" editor_type="LINK">soc-flickr>url</field>
				<field type="Team Members: Pinterest Url" editor_type="LINK">soc-pinterest>url</field>
				<field type="Team Members: Tumblr Url" editor_type="LINK">soc-tumblr>url</field>
				<field type="Team Members: Github Url" editor_type="LINK">soc-github>url</field>
				<field type="Team Members: Custom Url 1" editor_type="LINK">custom-soc-url-1>url</field>
				<field type="Team Members: Custom Url 2" editor_type="LINK">custom-soc-url-2>url</field>
			</fields-in-item>
		</widget>
		<widget name="ideapark-accordion">
			<fields>
				<field>accordion</field>
			</fields>
			<fields-in-item items_of="accordion">
				<field type="Accordion: Title" editor_type="LINE">title</field>
				<field type="Accordion: Content" editor_type="VISUAL">content</field>
			</fields-in-item>
		</widget>
		<widget name="ideapark-tabs">
			<fields>
				<field>tabs</field>
			</fields>
			<fields-in-item items_of="tabs">
				<field type="Tabs: Title" editor_type="LINE">title</field>
			</fields-in-item>
		</widget>
		<widget name="ideapark-video">
			<fields>
				<field type="Video Button: Link" editor_type="LINK">video_url</field>
			</fields>
		</widget>
		<widget name="ideapark-banners">
			<fields>
				<field>banner_list</field>
			</fields>
			<fields-in-item items_of="banner_list">
				<field type="Banners: Text Above The Title" editor_type="LINE">subheader</field>
				<field type="Banners: Title" editor_type="LINE">header</field>
				<field type="Banners: Button Text" editor_type="LINE">button_text</field>
				<field type="Banners: Link" editor_type="LINK">link>url</field>
			</fields-in-item>
		</widget>
		<widget name="ideapark-image-list-2">
			<fields>
				<field>icon_list</field>
			</fields>
			<fields-in-item items_of="icon_list">
				<field type="Logo List: Link" editor_type="LINK">link>url</field>
			</fields-in-item>
		</widget>
		<widget name="ideapark-services">
			<fields>
				<field>icon_list</field>
			</fields>
			<fields-in-item items_of="icon_list">
				<field type="Services: Title" editor_type="LINE">title_text</field>
				<field type="Services: Description" editor_type="AREA">description_text</field>
				<field type="Services: Button Text" editor_type="LINE">button_text</field>
				<field type="Services: Link" editor_type="LINK">link>url</field>
			</fields-in-item>
		</widget>
		<widget name="ideapark-gift">
			<fields>
				<field>gift_list</field>
			</fields>
			<fields-in-item items_of="gift_list">
				<field type="Gift Certificates: Title" editor_type="LINE">title</field>
				<field type="Gift Certificates: Description" editor_type="VISUAL">content</field>
				<field type="Gift Certificates: Description" editor_type="VISUAL">description</field>
				<field type="Gift Certificates: Price" editor_type="LINE">price</field>
				<field type="Gift Certificates: Button Text" editor_type="LINE">button_text</field>
				<field type="Gift Certificates: Link" editor_type="LINK">link>url</field>
				<field type="Gift Certificates: Badge text" editor_type="LINE">badge_text</field>
			</fields-in-item>
		</widget>
		<widget name="ideapark-pricing">
			<fields>
				<field>icon_list</field>
			</fields>
			<fields-in-item items_of="icon_list">
				<field type="Luchiana Price List: Title" editor_type="LINE">title_text</field>
				<field type="Luchiana Price List: Description" editor_type="VISUAL">description_text</field>
				<field type="Luchiana Price List: Price" editor_type="LINE">price</field>
				<field type="Luchiana Price List: Link" editor_type="LINK">link>url</field>
			</fields-in-item>
		</widget>
		<widget name="ideapark-circle-text">
			<fields>
				<field type="Circle Text: Title" editor_type="LINE">title</field>
				<field type="Circle Text: Link" editor_type="LINK">link>url</field>
			</fields>
		</widget>
		<widget name="ideapark-running-line">
			<fields>
				<field>item_list</field>
			</fields>
			<fields-in-item items_of="item_list">
				<field type="Infinite Marquee: Title" editor_type="LINE">title</field>
				<field type="Infinite Marquee: Link" editor_type="LINK">link>url</field>
			</fields-in-item>
		</widget>
		<widget name="ideapark-categories-inline">
			<fields>
				<field>icon_list</field>
			</fields>
			<fields-in-item items_of="icon_list">
				<field type="Categories Inline: Title" editor_type="LINE">title_text</field>
				<field type="Categories Inline: Link" editor_type="LINK">link>url</field>
			</fields-in-item>
		</widget>
		<widget name="ideapark-before-after">
			<fields>
				<field type="Before | After: Title Before" editor_type="LINE">title_before</field>
				<field type="Before | After: Title After" editor_type="LINE">title_after</field>
			</fields>
		</widget>
	</elementor-widgets>
</wpml-config>
