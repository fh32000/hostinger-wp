# ==============================================================================
# Git Ignore Configuration for WordPress & Multi-Site Monorepo
# ==============================================================================

# Database Dumps & SQL Backups (Never commit raw data)
*.sql
*.sql.gz
*.sql.zip
*.sqlite
*.db
/data/
init-db/*.sql
!init-db/.gitkeep

# WordPress Dynamic & User Content (Uploads, Caches, Backups)
sites/*/wp-content/uploads/
sites/*/wp-content/cache/
sites/*/wp-content/upgrade/
sites/*/wp-content/backups/
sites/*/wp-content/litespeed/
sites/*/wp-content/et-cache/
sites/*/.htaccess.bk
wp-content/uploads/
wp-content/cache/

# Vendor & 3rd-Party Plugins (Only custom plugins in plugins/ or sites/*/plugins/ are tracked)
sites/*/wp-content/plugins/elementor/
sites/*/wp-content/plugins/woocommerce/
sites/*/wp-content/plugins/revslider/
sites/*/wp-content/plugins/hostinger*/
sites/*/wp-content/plugins/et-core-plugin/
sites/*/wp-content/plugins/contact-form-7/
sites/*/wp-content/plugins/litespeed-cache/
sites/*/wp-content/plugins/meta-box/
sites/*/wp-content/plugins/mailchimp-for-wp/
sites/*/wp-content/plugins/woo-checkout-field-editor-pro/
sites/*/wp-content/plugins/woo-variation-swatches/
sites/*/wp-content/plugins/insert-headers-and-footers/
sites/*/wp-content/plugins/wp-reset/
sites/*/wp-content/plugins/ideapark-*/

# Docker & Local Runtime Data
db_data/
docker-entrypoint-initdb.d/*.sql

# Node & Python Dependencies / Caches
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
env/
venv/
ENV/

# Sensitive Files & Local Configs
.env
.env.local
*.log
*.pem
*.key
*.cert

# Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
